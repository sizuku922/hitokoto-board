doctype html
html(lang='ja')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title ひとこと掲示板
    link(rel='stylesheet', href='/style.css')
  body
    main.container
      h1 ひとこと掲示板
      p.lead 気軽にひとこと投稿できる掲示板です。
      section.panel
        h2 投稿する
        if error
          p.error= error
        form(action='/posts', method='POST')
          label(for='name') 名前（省略可）
          input#name(type='text', name='name', maxlength='20', placeholder='匿名')
          label(for='message') メッセージ（200文字まで）
          textarea#message(name='message', rows='4', maxlength='200', required, placeholder='ここに入力してください')
          button(type='submit') 投稿する
      section
        h2 投稿一覧
        if posts.length === 0
          p.empty まだ投稿はありません。
        each post in posts
          article.post
            .post-header
              strong= post.name
              small= post.date
            p.message= post.message
      footer ※ 投稿はサーバーの再起動時に消えます。個人情報は投稿しないでください。
